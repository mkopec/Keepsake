[Unit]
Description=TPM backed FIDO2 security key
Documentation=https://github.com/mkopec/keepsake
# Run only while a graphical session is up: nobody can confirm requests
# without one.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/keepsake
Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=graphical-session.target
